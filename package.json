{
  "name": "age-verification",
  "version": "1.0.0",
  "description": "100% Anonymous Age Verification",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "demo": "tsx age-verification-demo.ts",
    "demo:build": "esbuild demo/app.ts --bundle --format=iife --platform=browser --target=es2022 --inject:demo/buffer-shim.js --outfile=demo/app.js",
    "demo:test": "tsx demo/flow-test.ts",
    "demo:web": "npm run demo:build && node demo/serve.mjs",
    "test": "tsx age-verification-test.ts && npm run demo:test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/various-office-supplies/age-verification.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/various-office-supplies/age-verification/issues"
  },
  "homepage": "https://github.com/various-office-supplies/age-verification#readme",
  "dependencies": {
    "@docknetwork/crypto-wasm-ts": "^0.67.0",
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
